<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.cloudmall</groupId>
        <artifactId>cloud-mall-cloud</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <artifactId>search-service</artifactId>

    <dependencies>
        <!-- 项目内部模块 -->
        <dependency>
            <groupId>com.cloudmall</groupId>
            <artifactId>cloudmall-common-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.cloudmall</groupId>
            <artifactId>service-api</artifactId>
            <type>pom</type>
        </dependency>

        <!-- Spring Cloud Alibaba -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- 定时增量同步（XXL-Job） -->
        <dependency>
            <groupId>com.cloudmall</groupId>
            <artifactId>cloudmall-xxl-job-spring-boot-starter</artifactId>
        </dependency>

        <!-- 增量游标缓存 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Elasticsearch 官方 Java Client -->
        <dependency>
            <groupId>co.elastic.clients</groupId>
            <artifactId>elasticsearch-java</artifactId>
            <!-- 版本由 Spring Boot BOM 管理（8.18.x），兼容 compose 中的 ES 8.15.5 -->
        </dependency>

        <!-- Jackson JSR-310（LocalDateTime/Instant 序列化） -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- 参数校验 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- 公共配置包含 spring.datasource，需提供驱动供自动配置加载 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Openfeign -->
        <dependency>
            <groupId>com.cloudmall</groupId>
            <artifactId>cloudmall-feign-spring-boot-starter</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
